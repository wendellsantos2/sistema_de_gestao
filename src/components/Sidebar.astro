---
interface Props {
  activeTab?: string;
}

const { activeTab = 'dashboard' } = Astro.props;
---

<aside class="sidebar" id="mainSidebar">
  <div class="sidebar-header">
    <div class="brand-badge">
      <div class="brand-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
          <path d="M2 17l10 5 10-5"></path>
          <path d="M2 12l10 5 10-5"></path>
        </svg>
      </div>
      <div class="brand-title">
        <h1>GESTÃO 360</h1>
        <span>Multiempresas • v1.0</span>
      </div>
    </div>
  </div>

  <nav class="nav-menu">
    <div class="nav-section-title">Navegação Principal</div>
    
    <button type="button" class="nav-item active" data-tab="dashboard">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7"></rect>
        <rect x="14" y="3" width="7" height="7"></rect>
        <rect x="14" y="14" width="7" height="7"></rect>
        <rect x="3" y="14" width="7" height="7"></rect>
      </svg>
      <span>Painel Geral</span>
    </button>

    <button type="button" class="nav-item" data-tab="vencimentos">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span>Vencimentos & Renovações</span>
      <span class="nav-badge" id="badgeVencimentos">2</span>
    </button>

    <button type="button" class="nav-item" data-tab="dp">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
      <span>Depto Pessoal & Ocorrências</span>
      <span class="nav-badge warning" id="badgeDp">1</span>
    </button>

    <button type="button" class="nav-item" data-tab="epis">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
      <span>Controle de EPIs</span>
      <span class="nav-badge warning" id="badgeEpis">2</span>
    </button>

    <button type="button" class="nav-item" data-tab="documentos">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
      <span>Biblioteca de Documentos</span>
    </button>

    <button type="button" class="nav-item" data-tab="tarefas">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 11l3 3L22 4"></path>
        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
      </svg>
      <span>Gestão de Tarefas</span>
      <span class="nav-badge" id="badgeTarefas">4</span>
    </button>

    <div class="nav-section-title" style="margin-top: 14px;">Contratação & Proposta</div>

    <button type="button" class="nav-item" data-tab="proposta" style="color: #a5b4fc;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="12" y1="18" x2="12" y2="12"></line>
        <line x1="9" y1="15" x2="15" y2="15"></line>
      </svg>
      <span style="font-weight: 700;">Proposta Técnica & Comercial</span>
    </button>
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-commercial-cta" id="btnOpenPropostaFooter">
      <span>Edital Preliminar</span>
      <p>Ver Proposta & Orçamento</p>
    </div>
  </div>
</aside>
