---
---

<div id="view-epis" class="view-section" style="display:none;">
  <div class="card-panel">
    <div class="panel-header" style="flex-wrap: wrap; gap: 12px;">
      <div class="panel-title-group">
        <h2>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          Módulo de Controle de EPIs & Fichas de Entrega (Item 5)
        </h2>
        <p>Validade dupla (Validade do CA pelo MTE vs Vida útil do Equipamento), inspeções e histórico de movimentações</p>
      </div>

      <button type="button" class="btn btn-primary" id="btnNovoEpiModal">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>Nova Entrega / Movimentação de EPI</span>
      </button>
    </div>

    <!-- Alertas Preventivos de EPIs -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-bottom: 20px;">
      <div style="background: var(--bg-surface-elevated); padding: 14px 18px; border-radius: var(--radius-md); border-left: 4px solid var(--status-yellow);">
        <div style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-dim); font-weight: 700;">Alerta de CA Vencendo</div>
        <div style="font-size: 1.4rem; font-weight: 800; color: #fbbf24; margin-top: 4px;" id="kpiEpiCaVencendo">1</div>
        <div style="font-size: 0.75rem; color: var(--text-muted);">Máscara de Solda (CA 41209)</div>
      </div>

      <div style="background: var(--bg-surface-elevated); padding: 14px 18px; border-radius: var(--radius-md); border-left: 4px solid var(--status-red);">
        <div style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-dim); font-weight: 700;">Substituição / Troca Vencida</div>
        <div style="font-size: 1.4rem; font-weight: 800; color: #f87171; margin-top: 4px;" id="kpiEpiTrocaNecessaria">1</div>
        <div style="font-size: 0.75rem; color: var(--text-muted);">Botina PU (Uso severo 12 meses)</div>
      </div>

      <div style="background: var(--bg-surface-elevated); padding: 14px 18px; border-radius: var(--radius-md); border-left: 4px solid var(--status-green);">
        <div style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-dim); font-weight: 700;">EPIs Regulares sob Custódia</div>
        <div style="font-size: 1.4rem; font-weight: 800; color: #34d399; margin-top: 4px;" id="kpiEpiRegulares">3</div>
        <div style="font-size: 0.75rem; color: var(--text-muted);">Com inspeções em conformidade</div>
      </div>
    </div>

    <!-- Tabela de EPIs -->
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Empresa</th>
            <th>Equipamento</th>
            <th>Colaborador Custodiante</th>
            <th>Nº CA (Validade MTE)</th>
            <th>Vida Útil Equipamento</th>
            <th>Próxima Inspeção</th>
            <th>Situação</th>
            <th style="text-align: right;">Histórico & Ações</th>
          </tr>
        </thead>
        <tbody id="episTableBody">
          <!-- Renderizado dinamicamente -->
        </tbody>
      </table>
    </div>
  </div>
</div>
